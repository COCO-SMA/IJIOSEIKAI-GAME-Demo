# Unity —— Library 有 1.39 GB，必须挡住；Assets 全量只有 0.5 MB
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/

# IDE 生成物（Unity 会自动重建）
unity/*.csproj
unity/*.unityproj
unity/*.sln
unity/*.suo
unity/*.user
unity/*.userprefs
unity/*.pidb
unity/*.booproj
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db
